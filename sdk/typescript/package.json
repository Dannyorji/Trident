{
  "name": "@trident-indexer/sdk",
  "version": "1.0.0",
  "description": "TypeScript client SDK for the Trident Soroban event indexer",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:types": "python3 ../../scripts/generate_sdk_models.py --language typescript",
    "generate:models": "python3 ../../scripts/generate_sdk_models.py",
    "generate:models:go": "python3 ../../scripts/generate_sdk_models.py --language go",
    "generate:models:python": "python3 ../../scripts/generate_sdk_models.py --language python",
    "generate:models:rust": "python3 ../../scripts/generate_sdk_models.py --language rust",
    "generate:models:typescript": "python3 ../../scripts/generate_sdk_models.py --language typescript"
  },
  "dependencies": {
    "ws": "^8.21.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.18.1",
    "msw": "^2.14.6",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
