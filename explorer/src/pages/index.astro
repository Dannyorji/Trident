---
import Base from '../layouts/Base.astro';
import type { Network } from '../lib/types';

const rawNetwork = Astro.url.searchParams.get('network');
const network: Network = rawNetwork === 'mainnet' ? 'mainnet' : 'testnet';

// No-JS search redirect: ?q=C...
const searchQuery = Astro.url.searchParams.get('q')?.trim();
if (searchQuery) {
  return Astro.redirect(`/contract/${encodeURIComponent(searchQuery)}?network=${network}`);
}
---

<Base
  title="Soroban Event Explorer"
  description="Browse Soroban smart contract events on Stellar. No API key required."
>
  <!-- Hero -->
  <section class="text-center py-14">
    <h1 class="text-4xl font-bold mb-3 text-white">Soroban Event Explorer</h1>
    <p class="text-gray-400 mb-8 text-lg">
      Browse contract events on the Stellar network — no API key required.
    </p>

    <!-- Search form (works without JS via ?q= redirect) -->
    <form method="get" class="flex gap-2 max-w-2xl mx-auto" id="search-form">
      <label for="contract-input" class="sr-only">Soroban contract address</label>
      <input
        type="text"
        name="q"
        id="contract-input"
        placeholder="Soroban contract address (C...)"
        class="flex-1 px-4 py-2.5 rounded-lg bg-gray-800 border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent font-mono text-sm"
        autocomplete="off"
        spellcheck="false"
        aria-label="Soroban contract address"
        aria-describedby="search-help"
      />
      <input type="hidden" name="network" value={network} />
      <button
        type="submit"
        class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 rounded-lg text-white font-semibold text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-gray-950"
        aria-label="Search for contract"
      >
        Explore
      </button>
    </form>
    <p id="search-help" class="sr-only">Enter a contract address starting with C</p>

    <!-- Network toggle -->
    <div class="mt-4 flex justify-center gap-2 text-sm" role="group" aria-label="Network selector">
      <a
        href="?network=testnet"
        class={`px-4 py-1.5 rounded-full font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-gray-950 ${
          network === 'testnet'
            ? 'bg-indigo-600 text-white'
            : 'text-gray-400 hover:text-white hover:bg-gray-800'
        }`}
        aria-current={network === 'testnet' ? 'page' : undefined}
      >
        Testnet
      </a>
      <a
        href="?network=mainnet"
        class={`px-4 py-1.5 rounded-full font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-gray-950 ${
          network === 'mainnet'
            ? 'bg-indigo-600 text-white'
            : 'text-gray-400 hover:text-white hover:bg-gray-800'
        }`}
        aria-current={network === 'mainnet' ? 'page' : undefined}
      >
        Mainnet
      </a>
    </div>
  </section>

  <!-- Live ticker (client-rendered: skeleton → recent events or an honest state) -->
  <section class="mt-4" aria-label="Recent events ticker">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest">
        Recent Events
        <span
          id="ticker-dot"
          class="inline-block w-1.5 h-1.5 rounded-full ml-2 align-middle"
          role="status"
          aria-label="Live ticker status"
          aria-live="polite"
        ></span>
      </h2>
      <span class="text-xs text-gray-600">Updates every 10s</span>
    </div>

    <ul id="event-ticker" class="space-y-1.5" aria-live="polite" aria-label="Recent events">
      <noscript>
        <li class="text-gray-500 text-sm py-4 text-center">
          Recent events load client-side. Enable JavaScript to see them, or
          <a href="/api/recent-events.json?network={network}" class="text-indigo-400 hover:underline">view the raw feed</a>.
        </li>
      </noscript>
    </ul>
  </section>

  <!-- CTA -->
  <section class="mt-16 text-center text-sm text-gray-400">
    Need programmatic access?
    <a
      href="https://app.trident.dev/signup"
      class="text-indigo-400 hover:text-indigo-300 hover:underline focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded"
      target="_blank"
      rel="noopener noreferrer">Get an API key</a
    > for higher rate limits and real-time subscriptions.
  </section>
</Base>

<script>
  // Enhance search form: navigate to path-based URL
  const form = document.getElementById('search-form') as HTMLFormElement | null;
  const input = document.getElementById('contract-input') as HTMLInputElement | null;
  if (form && input) {
    form.addEventListener('submit', (e) => {
      const val = input.value.trim();
      if (!val) return;
      e.preventDefault();
      const network =
        (form.querySelector('input[name="network"]') as HTMLInputElement | null)?.value ??
        'testnet';
      window.location.href = `/contract/${encodeURIComponent(val)}?network=${network}`;
    });
  }
</script>

<script>
  import '../lib/ticker';
</script>