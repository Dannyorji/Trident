---
interface Props {
  title: string;
  message: string;
  icon?: 'search' | 'inbox' | 'clock';
  actionText?: string;
  actionUrl?: string;
}

const { title, message, icon = 'inbox', actionText, actionUrl } = Astro.props;

const icons = {
  search: '🔍',
  inbox: '📭',
  clock: '⏳',
};
---

<div class="text-center py-16 px-4">
  <div class="text-4xl mb-3">{icons[icon]}</div>
  <h3 class="text-lg font-semibold text-white mb-2">{title}</h3>
  <p class="text-gray-400 mb-4 max-w-md">{message}</p>
  {
    actionText && actionUrl && (
      <a
        href={actionUrl}
        class="inline-block text-sm px-4 py-2 rounded bg-indigo-600 hover:bg-indigo-500 text-white transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500"
      >
        {actionText}
      </a>
    )
  }
</div>
