---
import type { ErrorState } from '../lib/errors';

interface Props {
  error: ErrorState;
  onRetry?: () => void;
}

const { error, onRetry } = Astro.props;
const hasAction = error.actionText && (error.actionUrl || onRetry);
---

<div
  class="rounded-lg border border-red-800 bg-red-900/30 px-4 py-4"
  role="alert"
  aria-label={error.title}
>
  <!-- Title -->
  <h3 class="text-sm font-semibold text-red-400 mb-1">{error.title}</h3>

  <!-- Message -->
  <p class="text-sm text-red-300 mb-2">{error.message}</p>

  <!-- Details (if provided) -->
  {
    error.details && (
      <p class="text-xs text-red-400/70 mb-3 font-mono">{error.details}</p>
    )
  }

  <!-- Action -->
  {
    hasAction && (
      <div class="flex gap-2">
        {error.actionUrl ? (
          <a
            href={error.actionUrl}
            target={error.actionUrl.startsWith('http') ? '_blank' : undefined}
            rel={error.actionUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="text-xs px-3 py-1.5 rounded bg-red-700 hover:bg-red-600 text-red-100 transition-colors focus:outline-none focus:ring-2 focus:ring-red-500"
          >
            {error.actionText}
          </a>
        ) : (
          <button
            onclick="location.reload()"
            class="text-xs px-3 py-1.5 rounded bg-red-700 hover:bg-red-600 text-red-100 transition-colors focus:outline-none focus:ring-2 focus:ring-red-500"
          >
            {error.actionText}
          </button>
        )}
      </div>
    )
  }
</div>
