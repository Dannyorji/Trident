# Never send local credentials or private key material to a Docker builder.
# The runtime images receive secrets only when the platform starts them.
.git
.env
.env.*
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/kubeconfig
**/kubeconfig.*
**/*.kubeconfig
**/.npmrc
**/.netrc
**/id_rsa
**/id_ed25519
